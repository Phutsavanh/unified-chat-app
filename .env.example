PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# Optional: enables AI auto-subtitles in the video editor (/editor.html).
# Can also be set from the editor's ⚙ settings.
OPENAI_API_KEY=
# Optional: model used to translate subtitles (default gpt-4o-mini).
OPENAI_TRANSLATE_MODEL=
# Optional: OpenAI voiceover model (default gpt-4o-mini-tts).
OPENAI_TTS_MODEL=
# Optional: Azure Speech for natural Lao AI voiceover (lo-LA neural voices).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: ElevenLabs for cloned-voice presets (🧬 tab in the editor).
ELEVENLABS_API_KEY=
# Optional: default ElevenLabs model for new voices (default eleven_v3).
ELEVENLABS_MODEL=
